# Vamos needs no secrets and no API keys.
# Optional: base path for the production build. GitHub Pages project sites
# use "/<repository-name>/". Leave unset to build with relative paths ("./").
VITE_BASE=/vamos/
# Optional, tests only: path to a preinstalled Chromium for Playwright.
# PW_EXECUTABLE=/opt/pw-browsers/chromium-1243/chrome-linux64/chrome
